# Local credentials and private material must never enter the repository.
.env
.env.*
!.env.example
.secrets/
secrets/
*.key
*.pem
*.p12
*.pfx
*.token
credentials*.json

# Local build/test output.
dist/
release-assets/
*.log
__pycache__/
*.pyc
